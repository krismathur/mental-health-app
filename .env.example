# Copy to .env and fill in. Never commit the real .env.

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Google Gemini. Powers the training plan, the coach chat, and the
# meditation voice. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# YouTube Data API v3 key, used by "Fix What Went Wrong" to find a matching
# clip. Without it the app falls back to scraping YouTube's search page,
# which Google's abuse detection blocks. Your GEMINI_API_KEY works here too
# once "YouTube Data API v3" is enabled for that project in Google Cloud.
YOUTUBE_API_KEY=

# Set to "production" on the live server. This turns on HTTPS redirects,
# secure cookies, HSTS, and real cache headers -- and makes the app refuse
# to start if SESSION_SECRET is missing.
NODE_ENV=development

PORT=3000

# Where the SQLite files live. Point this at your host's persistent disk so
# the database is not wiped on redeploy. Defaults to ./data
# DATA_DIR=/home/user/mindzone-data

# Set to "false" only if the app is NOT behind a proxy or load balancer.
# TRUST_PROXY=false

# The app's own public address, used to build password reset links. Must be
# set in production: the link cannot be built from the request, because an
# attacker controls the Host header and could point a real token at their site.
APP_URL=http://localhost:3000

# Outbound email, used only for password reset. Without these the reset flow
# turns itself off (the "Forgot password?" link stays hidden) rather than
# accepting requests it cannot deliver. Hostinger's own email hosting works
# here: smtp.hostinger.com, port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MindZone <no-reply@yourdomain.com>
